<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.netmirror.companion">

    <!-- Safe Standard Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Allow installing on all Android devices (Phones, Tablets, Android TV, Fire TV) -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- Standard Compliant Queries for finding installed launcher apps & packages -->
    <queries>
        <!-- Standard query to discover launcher apps on Android 11+ without Play Protect flags -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <package android:name="com.netmirrortv" />
        <package android:name="com.netmirror.tv" />
        <package android:name="com.netmirror.tvos" />
        <package android:name="com.netmirror" />
        <package android:name="com.netmirror.app" />
        <package android:name="com.netmirror.android" />
        <package android:name="tv.netmirror" />
        <package android:name="org.netmirror" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="netmirror" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="netmirrortv" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:banner="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetMirrorCompanion"
        android:usesCleartextTraffic="true">
        
        <activity
            android:name="com.netmirror.companion.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- 1. Standard Android Phone / Tablet App Drawer -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- 2. Android TV / Google TV / Fire TV App Drawer -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
