<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused on TV Remote -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A3245" />
            <stroke android:width="2.5dp" android:color="@color/accent_cyan" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F2636" />
            <stroke android:width="1.5dp" android:color="@color/border_color" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <stroke android:width="1.5dp" android:color="@color/border_color" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
